# Copy this file to android/local.properties and update the values for your app.
# Do not commit the real file with secrets or machine-specific paths.

sdk.dir=/Users/YOUR_USER/Library/Android/sdk

# Real Play package name for the Android app.
APP_APPLICATION_ID=com.yourcompany.familysecurity

# Optional: keep the namespace aligned with the app id if you want.
# If omitted, APP_APPLICATION_ID will also be used as the applicationId.
APP_NAMESPACE=com.yourcompany.familysecurity

# Android Google Maps / Geocoding API key.
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_MAPS_KEY
